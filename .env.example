DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: n8n webhook that sends the "확정 알림톡" (KakaoTalk) message.
# The n8n workflow holds the actual Kakao provider (Solapi/NHN/etc.) credentials.
# If unset, the resend action logs a warning and just records the timestamp locally.
N8N_ALIMTALK_WEBHOOK_URL=""

# Required for the public reservation-intake API (POST /api/public/reservations).
# The homepage's backend must send this as `Authorization: Bearer <value>`.
# Requests without a matching key are rejected with 401; if this is unset, the
# endpoint refuses every request with 500 rather than accepting unauthenticated data.
RESERVATION_API_KEY=""
