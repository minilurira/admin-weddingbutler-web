generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  // 비밀번호 찾기 인증번호를 받을 휴대폰(숫자만). 비어 있으면 비밀번호 찾기를 쓸 수 없다.
  phone        String   @default("")
  createdAt    DateTime @default(now())
}

// Status values: "신규요청" | "협의중" | "확정" | "취소"
// Plan keys: "스몰케어" | "스탠다드" | "프리미엄"
model Reservation {
  id             String   @id
  customer       String
  couple         String
  // 축의대 구분: "신랑측" | "신부측" | "양가"(프리미엄) | ""(이전 예약)
  side           String   @default("")
  phone          String
  requestedAt    DateTime
  wishDateLabel  String
  venueLabel     String
  guestsLabel    String
  memo           String
  // 고객이 홈페이지 예약 때 직접 남긴 메모(선택). 없으면 ""
  customerMemo   String   @default("")
  status         String
  requestedPlan  String

  confirmDate        String
  confirmTime         String
  confirmVenue        String
  confirmPlan         String
  confirmButlers      Int
  confirmExtraGuests  Int
  confirmDiscount     Int      @default(0)
  confirmHours        String
  confirmNote         String   @default("")

  paidAmount     Int      @default(0)
  // 홈페이지 결제 유형: "deposit"(예약금 결제 후 현장결제) | "full"(전액결제) | ""(미지정, 이전 예약)
  paymentType    String   @default("")
  // 홈페이지가 보낸 신청 금액(기본 요금 + 추가 버틀러). 0이면 홈페이지 금액 없음(이전·수동 예약)
  requestedTotal         Int @default(0)
  requestedExtraButlers  Int @default(0)

  alimtalkAt     DateTime?

  cancelReason   String    @default("")
  cancelledAt    DateTime?
  refundAmount   Int       @default(0)

  notes          Note[]
  recordLink     RecordLink?
  paymentLinks   PaymentLink[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Note {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime    @default(now())
}

// 어드민에서 고객에게 보낸 결제 링크 (포트원 V1 링크페이). 다시 보내면 새 행이 생기고 이전 링크는 cancelled.
// status: "sent" | "paid" | "cancelled" (만료는 expiresAt으로 판단). paymentType: "deposit" | "full" | ""
model PaymentLink {
  id             String      @id @default(cuid())
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  merchantUid    String      @unique
  amount         Int
  paymentType    String      @default("")
  url            String      @default("")
  expiresAt      DateTime
  status         String      @default("sent")
  sentVia        String      @default("")
  impUid         String?     @unique
  paidAmount     Int         @default(0)
  paidAt         DateTime?
  refundedAmount Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([reservationId])
}

// 고객용 축의 기록 (홈페이지 /r/[token]). 예약 1건당 링크 1개.
// status: "draft" | "published" | "revoked", recordMode: "opened" | "sealed"
model RecordLink {
  id                    String         @id @default(cuid())
  reservationId         String         @unique
  reservation           Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  token                 String         @unique
  status                String         @default("draft")
  recordMode            String         @default("opened")
  handoverAt            DateTime?
  handoverEnvelopeCount Int            @default(0)
  receiverLabel         String         @default("")
  staffCount            Int            @default(0)
  videoUrl              String         @default("")
  version               Int            @default(0)
  publishedAt           DateTime?
  expiresAt             DateTime?
  entries               RecordEntry[]
  accesses              RecordAccess[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

// side: "신랑측" | "신부측". 밀봉 모드면 amount는 null.
model RecordEntry {
  id           String     @id @default(cuid())
  recordLinkId String
  recordLink   RecordLink @relation(fields: [recordLinkId], references: [id], onDelete: Cascade)
  envelopeNo   Int
  side         String
  name         String
  relation     String     @default("")
  amount       Int?
  tickets      Int        @default(0)
  memo         String     @default("")

  @@unique([recordLinkId, envelopeNo])
}

// kind: "otp" (문자 인증번호 발송) | "view" (열람). viewer: "customer" | "admin"
model RecordAccess {
  id           String     @id @default(cuid())
  recordLinkId String
  recordLink   RecordLink @relation(fields: [recordLinkId], references: [id], onDelete: Cascade)
  kind         String
  viewer       String     @default("customer")
  codeHash     String?
  expiresAt    DateTime?
  attempts     Int        @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([recordLinkId, kind, createdAt])
}

// 홈페이지 예약 조회(휴대폰 번호) 문자 인증번호. phone은 숫자만.
model LookupOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// 정산 관리 (/finance). 날짜는 "YYYY-MM-DD" 문자열. kind: "once" | "monthly"
model FinanceCost {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  kind      String
  date      String
  memo      String   @default("")
  // 실제로 통장에서 지급한 달별 기록. JSON {"YYYY-MM": "지급일 YYYY-MM-DD"} (월 비용은 달마다, 일회성은 그 달 한 번)
  payments  String   @default("{}")
  createdAt DateTime @default(now())
}

model Butler {
  id        String        @id @default(cuid())
  name      String
  // 새 참석 기록을 입력할 때 처음 보여 줄 등급(기본값). 실제 등급은 참석 기록(ButlerShift.grade)마다 정한다.
  grade     String        @default("staff")
  createdAt DateTime      @default(now())
  shifts    ButlerShift[]
}

// 버틀러 1명이 예약 1건에 참석한 기록과 정산 금액. reservationId는 Reservation.id (삭제와 무관하게 남기려고 관계를 걸지 않는다)
model ButlerShift {
  id            String   @id @default(cuid())
  butlerId      String
  butler        Butler   @relation(fields: [butlerId], references: [id], onDelete: Cascade)
  date          String
  reservationId String
  // 이번 참석의 등급: "staff" | "manager" | "owner" — 등급마다 건당 기본 정산금이 정해져 있다 (src/lib/financeCalc.ts)
  grade         String   @default("staff")
  pay           Int
  // 스페셜 차지: 오너가 기본 정산금 외에 추가로 지급하는 돈
  extra         Int      @default(0)
  paid          Boolean  @default(false)
  // 실제로 버틀러에게 입금한 날짜 ("YYYY-MM-DD"). 입금 전에는 빈 문자열.
  paidDate      String   @default("")
  createdAt     DateTime @default(now())

  @@index([date])
}

// 예식 당일 현금으로 받은 잔금. 행이 없으면 아직 입력하지 않은 것.
model FinanceCash {
  reservationId String   @id
  amount        Int
  updatedAt     DateTime @updatedAt
}

// key: "feeRate"(카드 수수료율 %) | "bankDate" | "bankBalance"
model FinanceSetting {
  key   String @id
  value String
}

// 스페셜 예약 링크: 관리자가 금액을 정해 만들고, 고객이 링크에서 날짜·예식장·시간을 골라 전액 결제한다.
// status: "open" | "held"(결제 진행 중) | "used" | "cancelled". 만료는 expiresAt 로 판단한다.
model SpecialOffer {
  id        String    @id @default(cuid())
  token     String    @unique
  amount    Int
  label     String    @default("")
  status    String    @default("open")
  bookingNo String    @default("")
  heldAt    DateTime?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// 예약별 고객·직원 알림톡/문자 발송 기록. 알림톡은 변수만 저장하고, 화면에서 솔라피 템플릿 본문에 채워 보여 준다.
// status: "sent"(솔라피가 발송 요청을 받음) | "failed" | "skipped"(솔라피 설정이 없어 건너뜀)
model MessageLog {
  id            String   @id @default(cuid())
  reservationId String
  kind          String
  channel       String
  recipient     String   @default("")
  templateId    String   @default("")
  variables     String   @default("{}")
  content       String   @default("")
  status        String
  detail        String   @default("")
  createdAt     DateTime @default(now())

  @@index([reservationId, createdAt])
}

// 캘린더에서 막아 둔 날짜·시간. 홈페이지 예약 화면에서 이 시간은 고를 수 없다.
// startTime/endTime이 비어 있으면 그날 종일. 있으면 그 시각 이상 ~ 종료 시각 이하의 예식 시간(TIME_SLOTS)을 막는다.
model CalendarBlock {
  id        String   @id @default(cuid())
  date      String
  startTime String   @default("")
  endTime   String   @default("")
  reason    String   @default("")
  createdAt DateTime @default(now())
}
